YOUTUBE_API_KEY=your-api-key
OPENAI_API_KEY=your-openai-key
OPENAI_MODEL=gpt-4o-mini

# OCR provider: "auto" (default, recommended), "gpt4o", "tesseract", or "mistral"
# auto = gpt4o (if configured) > tesseract
OCR_PROVIDER=auto

# Recommended: GPT-4o vision for social-media image analysis (structured extraction)
OPENAI_COMPAT_BASE_URL=https://your-resource.services.ai.azure.com/openai/v1
OPENAI_COMPAT_API_KEY=your-openai-compat-key
OPENAI_COMPAT_MODEL=gpt-4o

# Alternative: Mistral OCR via Azure Foundry
# AZURE_FOUNDRY_ENDPOINT=https://your-resource.services.ai.azure.com
# AZURE_FOUNDRY_API_KEY=your-azure-foundry-key
# AZURE_FOUNDRY_MODEL=mistral-ocr-2505-preview
