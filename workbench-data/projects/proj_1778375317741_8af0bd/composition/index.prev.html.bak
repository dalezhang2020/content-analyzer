  <script>
    // HyperFrames lint requires every data-composition-id root to have
    // a registered timeline on window.__timelines. The parent's own
    // timeline is a no-op container — the actual scene animations live
    // in each sub-composition's own __timelines[scene-NN-xxx] entry.
    window.__timelines = window.__timelines || {};
    window.__timelines["main"] = gsap.timeline({ paused: true });
